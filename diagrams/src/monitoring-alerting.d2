direction: right
vars: {d2-config: {layout-engine: elk; theme-id: 0}}
**.style.font-size: 24
**.style.font-color: "#0f172a"
**.style.border-radius: 12
classes: {
  default: {style: {fill: "#f1f5f9"; stroke: "#475569"; font-color: "#0f172a"; font-size: 24; border-radius: 12}}
  control: {style.fill: "#ede9fe"; style.stroke: "#7c3aed"}
  monitor: {style.fill: "#d1fae5"; style.stroke: "#047857"}
  overlay: {style.fill: "#ccfbf1"; style.stroke: "#0f766e"}
  caveat: {style.fill: "#fef3c7"; style.stroke: "#b45309"}
  planned: {style.fill: "#fef3c7"; style.stroke: "#b45309"; style.stroke-dash: 6}
  public: {style.stroke: "#047857"; style.stroke-width: 3; style.font-size: 24; style.font-color: "#0f172a"}
  private: {style.stroke: "#0f766e"; style.stroke-width: 3; style.stroke-dash: 6; style.font-size: 24; style.font-color: "#0f172a"}
  flow: {style.stroke: "#475569"; style.stroke-width: 2; style.font-size: 24; style.font-color: "#0f172a"}
  uncertain: {style.stroke: "#b45309"; style.stroke-dash: 6; style.font-size: 24; style.font-color: "#0f172a"}
}
agents: "Collection agents on every node\nFour hosts · conceptual grouping" {class: monitor}
home: "Home node" {
  class: default
  console: "One observability console\nGrafana · Loki · Prometheus\nMetrics · searchable logs\nAlert rules sized from a baseline" {class: monitor}
}
separate: "Separate host" {
  class: default
  witness: "Independent synthetic witness\nAvailability checks\nDelayed console-failure signal" {class: monitor}
}
notification: "Logical alert delivery path\nDelivery test planned" {class: caveat}
agents -> home.console: "Metrics and logs" {class: flow}
separate.witness -> home.console: "Synthetic availability check" {class: flow}
home.console -> notification: "Rule notifications" {class: uncertain}
separate.witness -> notification: "Independent failure signal" {class: uncertain}

legend: "Green: observability · slate: collection / checks\nDashed amber: notification path; delivery unverified\nOwner-supplied design · no security correlation" {
  shape: text
  near: bottom-center
  style.font-size: 26
  style.font-color: "#0f172a"
}
