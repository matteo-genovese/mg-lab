direction: down
vars: {d2-config: {layout-engine: elk; theme-id: 0}}
**.style.font-size: 28
**.style.font-color: "#0f172a"
**.style.border-radius: 16
classes: {
  group: {label.near: bottom-center; style: {fill: "#f1f5f9"; stroke: "#475569"; stroke-width: 1; font-size: 26; border-radius: 20}}
  host: {style: {fill: "#f1f5f9"; stroke: "#475569"; stroke-width: 2; font-size: 30; border-radius: 12}}
  actor: {style: {fill: "#f1f5f9"; stroke: "#475569"; stroke-width: 1; font-size: 28; border-radius: 24}}
  control: {style: {fill: "#ede9fe"; stroke: "#7c3aed"; stroke-width: 2; font-size: 30; border-radius: 12}}
  monitor: {style: {fill: "#14532d"; stroke: "#22c55e"; stroke-width: 2; font-size: 30; border-radius: 12}}
  overlay: {style: {fill: "#ccfbf1"; stroke: "#0f766e"; stroke-width: 2; font-size: 30; border-radius: 24}}
  public: {style: {stroke: "#1d4ed8"; stroke-width: 4; font-size: 26; font-color: "#0f172a"}}
  private: {style: {stroke: "#0f766e"; stroke-width: 2; stroke-dash: 6; font-size: 26; font-color: "#0f172a"}}
  local: {style: {stroke: "#475569"; stroke-width: 2; font-size: 26; font-color: "#0f172a"}}
}

title: "Network relationships" {
  shape: text
  near: top-center
  style.font-size: 46
  style.bold: true
}
internet: "Internet clients" {class: actor; width: 260; height: 56}
users: "Home users" {class: actor; width: 240; height: 56}
access: "" {
  direction: right
  class: group
  admin: "Administrator" {class: actor; width: 260; height: 56}
  tailnet: "Tailscale · admin plane\nFour logical host peers" {class: overlay; width: 400; height: 110}
  admin -> tailnet: {class: private}
}
ionos: "IONOS / PRODUCTION" {
  class: group
  prod: "mg-prod-01\nApplication ingress\nNginx Proxy Manager" {class: host; width: 320; height: 125}
}
home: "HOME / ROME" {
  class: group
  node: "mg-home-01\nPi-hole · local DNS\nLocal services" {class: host; width: 320; height: 125}
}
oci: "OCI / MILAN · MICRO VMs" {
  class: group
  mgmt: "mg-mgmt-01\nManagement VM\nPortainer · Beszel Hub" {class: control; width: 320; height: 125}
  mon: "mg-mon-01\nMonitoring VM\nUptime Kuma" {class: monitor; width: 320; height: 125; style.font-color: "#ffffff"}
}
internet -> ionos.prod: "Public applications" {class: public}
users -> home.node: "Local DNS" {class: local}
# Arrowless peer links: ELK direction is a layout constraint.
access.tailnet -> ionos.prod: {class: private; target-arrowhead.shape: none}
access.tailnet -> home.node: {class: private; target-arrowhead.shape: none}
access.tailnet -> oci.mgmt: {class: private; target-arrowhead.shape: none}
access.tailnet -> oci.mon: {class: private; target-arrowhead.shape: none}
legend: "Blue → public apps · Slate → local DNS · Teal ┄ admin peers\nPurple management · Green monitoring · Logical links only" {
  shape: text
  near: bottom-center
  style.font-size: 26
}
