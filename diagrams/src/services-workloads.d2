direction: right
vars: {d2-config: {layout-engine: elk; theme-id: 0}}
**.style.font-size: 24
**.style.font-color: "#0f172a"
**.style.border-radius: 12
classes: {
  default: {style: {fill: "#f1f5f9"; stroke: "#475569"; font-color: "#0f172a"; font-size: 24; border-radius: 12}}
  control: {style.fill: "#ede9fe"; style.stroke: "#7c3aed"}
  monitor: {style.fill: "#d1fae5"; style.stroke: "#047857"}
  overlay: {style.fill: "#ccfbf1"; style.stroke: "#0f766e"}
  caveat: {style.fill: "#fef3c7"; style.stroke: "#b45309"}
  planned: {style.fill: "#fef3c7"; style.stroke: "#b45309"; style.stroke-dash: 6}
  public: {style.stroke: "#047857"; style.stroke-width: 3; style.font-size: 24; style.font-color: "#0f172a"}
  private: {style.stroke: "#0f766e"; style.stroke-width: 3; style.stroke-dash: 6; style.font-size: 24; style.font-color: "#0f172a"}
  flow: {style.stroke: "#475569"; style.stroke-width: 2; style.font-size: 24; style.font-color: "#0f172a"}
  uncertain: {style.stroke: "#b45309"; style.stroke-dash: 6; style.font-size: 24; style.font-color: "#0f172a"}
}
estate: "Current roles · generic workload groups" {
  class: default
  grid-columns: 2
  grid-gap: 50
  public_host: "Public VPS" {
    class: default
    stack: "Application workloads\nThe proxy · proxy block list\nCollection agent\nTest configuration before reload" {class: default; width: 480; height: 200}
  }
  cloud: "Cloud nodes" {
    class: default
    grid-rows: 2
    grid-gap: 35
    mgmt: "Management node\nManagement workloads\nCollection agent" {class: control; width: 480; height: 160}
    mon: "Separate witness node\nIndependent synthetic checks\nCollection agent" {class: monitor; width: 480; height: 160}
  }
  home: "Home node" {
    class: default
    stack: "One observability console\nGrafana · Loki · Prometheus\nMetrics · searchable logs\nAlert rules sized from a baseline\nCollection agent · local workloads" {class: monitor; width: 480; height: 180}
  }
  edge: "Detection and blocking roles\nPlacement not specified" {
    class: default
    detection: "Detection produces events\nCentral event service" {class: control; width: 480; height: 120}
    blocking: "Proxy block-list enforcement\nAllowlist the CDN before blocking\nManual rollback remains available" {class: default; width: 480; height: 160}
  }
}

legend: "Owner-supplied design · no current health measurement\nPlacement by role; boxes do not imply one deployed stack\nSlate: workloads · purple: control · green: observability" {
  shape: text
  near: bottom-center
  style.font-size: 22
  style.font-color: "#0f172a"
}
